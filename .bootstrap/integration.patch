+# Optional for a fresh host. Existing AWS deployments may keep their existing Caddy override.
+services:
+  caddy:
+    image: caddy:2.10.2-alpine
+    restart: unless-stopped
+    environment:
+      LIBRECHAT_PUBLIC_HOST: ${LIBRECHAT_PUBLIC_HOST:?Run prepare-integration with an HTTPS origin}
+    ports:
+      - "80:80"
+      - "443:443"
+    volumes:
+      - ./Caddyfile.integration:/etc/caddy/Caddyfile:ro
+      - caddy_data:/data
+      - caddy_config:/config
+    networks: [app]
+    depends_on: [librechat]
+volumes:
+  caddy_data:
+  caddy_config:
diff --git a/deployment/compose.integration.yaml b/deployment/compose.integration.yaml
new file mode 100644
index 00000000..b15b95b5
--- /dev/null
+++ b/deployment/compose.integration.yaml
@@ -0,0 +1,23 @@
+# Apply AFTER compose.yaml (and any existing features/HTTPS overrides).
+services:
+  librechat:
+    image: open-harness/librechat-hermes:pilot
+    build:
+      context: ../src/LibreChat
+      dockerfile: Dockerfile
+      args:
+        NODE_MAX_OLD_SPACE_SIZE: "8192"
+    environment:
+      HERMES_BRIDGE_KEY: ${HERMES_BRIDGE_KEY:?Run tools/prepare-integration.cjs first}
+      HERMES_API_KEY: ${HERMES_API_KEY:?Missing Hermes gateway key}
+      HERMES_DASHBOARD_USERNAME: ${HERMES_DASHBOARD_BASIC_AUTH_USERNAME:?Missing dashboard username}
+      HERMES_DASHBOARD_PASSWORD: ${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:?Missing dashboard password}
+      HERMES_DASHBOARD_PROVIDER: basic
+    volumes:
+      - ./integration.librechat.yaml:/app/librechat.yaml:ro
+  hermes:
+    environment:
+      GATEWAY_MULTIPLEX_PROFILES: "true"
+      HERMES_DASHBOARD_PUBLIC_URL: ${DOMAIN_CLIENT:?Missing public LibreChat origin}/hermes-workspace
+      # Applies to profile adapters as well; keys remain profile scoped.
+      API_SERVER_ENABLED: "true"
