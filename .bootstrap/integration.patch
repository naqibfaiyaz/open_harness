+      }
+      setTimeout(() => res.end('data: {"choices":[{"delta":{"content":"Hermes"}}]}\n\ndata: [DONE]\n\n'), 20);
+    } else res.json({ choices: [{ message: { role: 'assistant', content: 'through Hermes' } }] });
+    return;
+  }
+  res.status(404).end();
+});
