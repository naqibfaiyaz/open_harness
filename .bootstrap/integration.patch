@@ -0,0 +1,53 @@
+export interface HermesConfig {
+  enabled: boolean;
+  managedOnly: boolean;
+  publicOrigin: string;
+  dashboardURL: string;
+  runtimeURL: string;
+  allowedUserIds: string[];
+  endpointName: string;
+}
+
+export interface HermesSecrets {
+  dashboardUsername: string;
+  dashboardPassword: string;
+  dashboardProvider: string;
+  runtimeKey: string;
+  bridgeKey: string;
+}
+
+export interface HermesUser {
+  id?: string;
+  _id?: unknown;
+  role?: string;
+}
+
+export function canManageHermes(user: HermesUser | undefined, config: HermesConfig): boolean {
+  if (!user) return false;
+  const id = user.id ?? String(user._id ?? '');
+  return config.enabled && (user.role === 'ADMIN' || config.allowedUserIds.includes(id));
+}
+
+export function validateHermesConfig(config: HermesConfig, secrets: HermesSecrets): void {
+  for (const value of [config.dashboardURL, config.runtimeURL, config.publicOrigin]) {
+    const url = new URL(value);
+    if (
+      !['http:', 'https:'].includes(url.protocol) ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash ||
+      url.pathname !== '/'
+    )
+      throw new Error('Invalid Hermes URL');
+  }
+  if (
+    secrets.bridgeKey.length < 32 ||
+    !secrets.runtimeKey ||
+    !secrets.dashboardUsername ||
+    !secrets.dashboardPassword ||
+    !secrets.dashboardProvider
+  ) {
+    throw new Error('Hermes integration secrets are incomplete');
+  }
+}
diff --git a/src/LibreChat/packages/api/src/hermes/dashboard.ts b/src/LibreChat/packages/api/src/hermes/dashboard.ts
new file mode 100644
index 00000000..6db649ad
--- /dev/null
+++ b/src/LibreChat/packages/api/src/hermes/dashboard.ts
@@ -0,0 +1,89 @@
+import type { HermesConfig, HermesSecrets } from './config';
+import { HERMES_PREFIX } from './sessions';
+
+/** Private cookie jar for the stock Hermes password provider, including refresh rotation. */
+export class HermesDashboard {
+  private cookies = new Map<string, string>();
+  private login?: Promise<void>;
+  constructor(
+    private config: HermesConfig,
+    private secrets: HermesSecrets,
+    private request: typeof fetch = fetch,
+  ) {}
+
+  private headers(input?: HeadersInit): Headers {
+    const headers = new Headers(input);
+    headers.set('X-Forwarded-Prefix', HERMES_PREFIX);
+    headers.set('X-Forwarded-Proto', new URL(this.config.publicOrigin).protocol.slice(0, -1));
+    headers.set('X-Forwarded-Host', new URL(this.config.publicOrigin).host);
+    return headers;
+  }
+
+  private capture(response: Response) {
+    for (const value of response.headers.getSetCookie()) {
+      const pair = value.split(';', 1)[0];
+      const index = pair.indexOf('=');
+      if (index <= 0) continue;
+      const name = pair.slice(0, index);
+      if (/max-age=0(?:;|$)/i.test(value)) this.cookies.delete(name);
+      else this.cookies.set(name, pair.slice(index + 1));
+    }
+  }
+
+  private async signIn() {
+    const response = await this.request(new URL('/auth/password-login', this.config.dashboardURL), {
+      method: 'POST',
+      redirect: 'manual',
+      signal: AbortSignal.timeout(15_000),
+      headers: this.headers({ 'Content-Type': 'application/json' }),
+      body: JSON.stringify({
+        provider: this.secrets.dashboardProvider,
+        username: this.secrets.dashboardUsername,
+        password: this.secrets.dashboardPassword,
+      }),
+    });
+    if (!response.ok) throw new Error('HERMES_AUTH_UNAVAILABLE');
+    this.capture(response);
+    if (!this.cookies.size) throw new Error('HERMES_AUTH_UNAVAILABLE');
+  }
+
+  async cookie(): Promise<string> {
+    if (!this.cookies.size) {
+      this.login ??= this.signIn().finally(() => {
+        this.login = undefined;
+      });
+      await this.login;
+    }
+    return [...this.cookies].map(([key, value]) => `${key}=${value}`).join('; ');
+  }
+
+  async fetch(path: string, init: RequestInit = {}, retry = true): Promise<Response> {
+    if (!path.startsWith('/') || path.startsWith('//')) throw new Error('Invalid dashboard path');
+    const headers = this.headers(init.headers);
+    headers.set('Cookie', await this.cookie());
+    const response = await this.request(`${this.config.dashboardURL}${path}`, {
+      ...init,
+      headers,
+      redirect: 'manual',
+      signal: init.signal ?? AbortSignal.timeout(30_000),
+    });
+    this.capture(response);
+    const location = response.headers.get('location') ?? '';
+    const loginRedirect =
+      response.status >= 300 &&
+      response.status < 400 &&
+      (location.startsWith('/login') || location.startsWith(`${HERMES_PREFIX}/login`));
+    if ((response.status === 401 || loginRedirect) && retry) {
+      await response.body?.cancel();
+      this.cookies.clear();
+      return this.fetch(path, init, false);
+    }
+    return response;
+  }
+
+  async json(path: string): Promise<Record<string, unknown>> {
+    const response = await this.fetch(path);
+    if (!response.ok) throw new Error('HERMES_UNAVAILABLE');
+    return response.json() as Promise<Record<string, unknown>>;
+  }
+}
diff --git a/src/LibreChat/packages/api/src/hermes/index.ts b/src/LibreChat/packages/api/src/hermes/index.ts
new file mode 100644
index 00000000..96acff34
--- /dev/null
+++ b/src/LibreChat/packages/api/src/hermes/index.ts
@@ -0,0 +1,273 @@
+import { Router } from 'express';
+import type { Request, Response, RequestHandler } from 'express';
+import type { Server } from 'node:http';
+import type { HermesConfig, HermesSecrets, HermesUser } from './config';
+import {
+  HERMES_COOKIE,
+  HERMES_PREFIX,
+  WorkspaceSessions,
+  readWorkspaceCookie,
+  serviceKeyMatches,
+  sessionKey,
+} from './sessions';
+import { attachWorkspaceUpgrades, isSameOrigin, proxyDashboard, sendUpstream } from './proxy';
+import { canManageHermes, validateHermesConfig } from './config';
+import { HermesDashboard } from './dashboard';
+export { createHermesBodyCapture, createHermesRequestSanitizer } from './body';
+import { HermesRuntime } from './runtime';
+
+interface Dependencies {
+  config: HermesConfig;
+  secrets: HermesSecrets;
+  authenticate: RequestHandler;
+  loadUser: (id: string) => Promise<HermesUser | undefined>;
+  fetch?: typeof fetch;
+}
+type UserRequest = Request & { user?: HermesUser };
+const messages: Record<string, string> = {
+  HERMES_PROFILE_OR_MODEL_NOT_READY:
+    'This Hermes agent or model is not ready. Enable it in Hermes workspace and start a new chat.',
+  HERMES_EXECUTION_REQUIRED:
+    'Select the Hermes endpoint. Manage agents and tools in Hermes workspace.',
+  HERMES_CONFIGURE_TOOLS_IN_WORKSPACE:
+    'Configure tools in Hermes workspace before starting a new chat.',
+  HERMES_SESSION_CONTEXT_REQUIRED:
+    'The LibreChat user or conversation context is missing from the server configuration.',
+  HERMES_UNAVAILABLE: 'Hermes is unavailable. Retry after checking its connection.',
+  HERMES_EXECUTION_FAILED:
+    'Hermes could not complete this request. Check the session in Hermes workspace.',
+};
+const error = (res: Response, status: number, code: string) =>
+  res
+    .status(status)
+    .json({ code, error: { type: 'hermes_integration_error', message: messages[code] ?? code } });
+export interface HermesIntegration {
+  api: Router;
+  workspace: Router;
+  executor: Router;
+  executionGuard: RequestHandler;
+  attach(server: Server): () => void;
+}
+
+export function createHermesIntegration(deps: Dependencies): HermesIntegration {
+  const { secrets, authenticate } = deps;
+  validateHermesConfig(deps.config, secrets);
+  const config = {
+    ...deps.config,
+    publicOrigin: new URL(deps.config.publicOrigin).origin,
+    dashboardURL: new URL(deps.config.dashboardURL).origin,
+    runtimeURL: new URL(deps.config.runtimeURL).origin,
+  };
+  const dashboard = new HermesDashboard(config, secrets, deps.fetch);
+  const runtime = new HermesRuntime(config, secrets, dashboard, deps.fetch);
+  const sessions = new WorkspaceSessions();
+  const api = Router();
+  const workspace = Router();
+  const executor = Router();
+  const safe =
+    (fn: (req: UserRequest, res: Response) => Promise<unknown>): RequestHandler =>
+    (req, res) => {
+      void fn(req as UserRequest, res).catch(() => {
+        if (!res.headersSent) error(res, 502, 'HERMES_UNAVAILABLE');
+        else res.destroy();
+      });
+    };
+
+  api.use(authenticate);
+  api.get('/status', (req, res) => {
+    res.json({
+      enabled: config.enabled,
+      managedOnly: config.managedOnly,
+      canManage: canManageHermes((req as UserRequest).user, config),
+      workspacePath: HERMES_PREFIX,
+      scope: 'shared-trusted-workspace',
+    });
+  });
+  api.use((req, res, next) => {
+    if (!canManageHermes((req as UserRequest).user, config)) {
+      error(res, 403, 'HERMES_FORBIDDEN');
+      return;
+    }
+    next();
+  });
+  const issueSession = safe(async (req, res) => {
+    if (!canManageHermes(req.user, config)) return error(res, 403, 'HERMES_FORBIDDEN');
+    if (!isSameOrigin(req.get('origin'), config.publicOrigin))
+      return error(res, 403, 'HERMES_ORIGIN_REFUSED');
+    const authorization = req.get('authorization') ?? '';
+    if (!authorization.startsWith('Bearer ')) return error(res, 401, 'HERMES_BEARER_REQUIRED');
+    await dashboard.cookie();
+    const grant = sessions.issue(
+      authorization.slice(7),
+      String(req.user?.id ?? req.user?._id),
+      readWorkspaceCookie(req.headers.cookie),
+    );
+    res.cookie(HERMES_COOKIE, grant, {
+      httpOnly: true,
+      secure: config.publicOrigin.startsWith('https:'),
+      // Lax permits top-level MCP OAuth callbacks. Writes still require the exact Origin.
+      sameSite: 'lax',
+      path: HERMES_PREFIX,
+      maxAge: 90_000,
+    });
+    res.setHeader('Cache-Control', 'no-store');
+    res.json({ workspacePath: HERMES_PREFIX, renewAfterMs: 45_000 });
+  });
+  workspace.post('/_session', authenticate, issueSession);
+  workspace.delete('/_session', authenticate, (req, res) => {
+    const cookie = readWorkspaceCookie(req.headers.cookie);
+    if (cookie) sessions.revoke(cookie);
+    res.clearCookie(HERMES_COOKIE, { path: HERMES_PREFIX });
+    res.status(204).end();
+  });
+  api.get(
+    '/profiles',
+    safe(async (_req, res) => res.json({ profiles: await runtime.profiles() })),
+  );
+  api.post(
+    '/publish',
+    safe(async (req, res) => {
+      if (!isSameOrigin(req.get('origin'), config.publicOrigin))
+        return error(res, 403, 'HERMES_ORIGIN_REFUSED');
+      if (typeof req.body?.profile !== 'string') return error(res, 400, 'HERMES_PROFILE_REQUIRED');
+      return res.json(await runtime.publish(req.body.profile));
+    }),
+  );
+
+  workspace.use((req, res, next) => {
+    const grant = sessions.get(readWorkspaceCookie(req.headers.cookie));
+    if (!grant) {
+      error(res, 401, 'HERMES_WORKSPACE_SESSION_EXPIRED');
+      return;
+    }
+    if (
+      !['GET', 'HEAD'].includes(req.method) &&
+      !isSameOrigin(req.get('origin'), config.publicOrigin)
+    ) {
+      error(res, 403, 'HERMES_ORIGIN_REFUSED');
+      return;
+    }
+    // Re-run LibreChat auth, retirement, tenant and enrollment gates on every HTTP request.
+    req.headers.authorization = `Bearer ${grant.token}`;
+    authenticate(req, res, next);
+  });
+  workspace.use(
+    safe(async (req, res) => {
+      if (!canManageHermes(req.user, config)) return error(res, 403, 'HERMES_FORBIDDEN');
+      await proxyDashboard(req, res, config, dashboard);
+    }),
+  );
+
+  executor.use((req, res, next) => {
+    if (!serviceKeyMatches(req.get('authorization'), secrets.bridgeKey)) {
+      error(res, 401, 'HERMES_SERVICE_AUTH_REQUIRED');
+      return;
+    }
+    next();
+  });
+  executor.get(
+    '/models',
+    safe(async (_req, res) => res.json(await runtime.catalog())),
+  );
+  executor.post(
+    '/chat/completions',
+    safe(async (req, res) => {
+      const user = req.get('x-librechat-user-id');
+      const conversation = req.get('x-librechat-conversation-id');
+      if (!user || !conversation || user.includes('{{') || conversation.includes('{{')) {
+        return error(res, 400, 'HERMES_SESSION_CONTEXT_REQUIRED');
+      }
+      if (!(await deps.loadUser(user))) return error(res, 403, 'HERMES_USER_UNAVAILABLE');
+      if (typeof req.body?.model !== 'string' || !Array.isArray(req.body.messages)) {
+        return error(res, 400, 'HERMES_INVALID_CHAT');
+      }
+      // Native LibreChat tool definitions cannot secretly create a second execution loop.
+      if (req.body.tools?.length || req.body.functions?.length) {
+        return error(res, 400, 'HERMES_CONFIGURE_TOOLS_IN_WORKSPACE');
+      }
+      let target;
+      try {
+        target = await runtime.resolve(req.body.model);
+      } catch {
+        return error(res, 409, 'HERMES_PROFILE_OR_MODEL_NOT_READY');
+      }
+      const abort = new AbortController();
+      req.once('aborted', () => abort.abort());
+      res.once('close', () => abort.abort());
+      // Allowlist inference fields. Never accept body-level profile/provider/API-key overrides.
+      const body: Record<string, unknown> = { model: target.model, messages: req.body.messages };
+      for (const key of [
+        'stream',
+        'temperature',
+        'top_p',
+        'max_tokens',
+        'max_completion_tokens',
+        'stop',
+        'presence_penalty',
+        'frequency_penalty',
+        'reasoning_effort',
+        'stream_options',
+      ]) {
+        if (req.body[key] !== undefined) body[key] = req.body[key];
+      }
+      const response = await (deps.fetch ?? fetch)(target.url, {
+        method: 'POST',
+        redirect: 'error',
+        signal: abort.signal,
+        headers: {
+          Authorization: `Bearer ${target.key}`,
+          'Content-Type': 'application/json',
+          'X-Hermes-Session-Key': sessionKey(secrets.bridgeKey, user, conversation),
+        },
+        body: JSON.stringify(body),
+      });
+      if (!response.ok) {
+        await response.body?.cancel();
+        return error(res, response.status, 'HERMES_EXECUTION_FAILED');
+      }
+      await sendUpstream(response, res);
+    }),
+  );
+
+  const executionGuard: RequestHandler = (req, res, next) => {
+    if (!config.managedOnly || req.method !== 'POST' || req.path.endsWith('/abort')) {
+      next();
+      return;
+    }
+    const endpoint = req.body?.endpoint;
+    if (
+      endpoint !== config.endpointName ||
+      req.body?.agent_id ||
+      req.body?.endpointOption?.agent_id ||
+      req.originalUrl.startsWith('/api/assistants/')
+    ) {
+      error(res, 403, 'HERMES_EXECUTION_REQUIRED');
+      return;
+    }
+    // The server's custom endpoint configuration chooses the provider, never a client override.
+    req.body.endpointType = 'custom';
+    req.body.ephemeralAgent = {
+      mcp: [],
+      web_search: false,
+      file_search: false,
+      execute_code: false,
+      skills: false,
+      memory: false,
+      ask_user_question: false,
+      run_in_background: false,
+      describe_intent: false,
+      artifacts: '',
+    };
+    next();
+  };
+
+  return {
+    api,
+    workspace,
+    executor,
+    executionGuard,
+    attach(server: Server) {
+      return attachWorkspaceUpgrades(server, config, dashboard, sessions, deps.loadUser);
+    },
+  };
+}
diff --git a/src/LibreChat/packages/api/src/hermes/proxy.ts b/src/LibreChat/packages/api/src/hermes/proxy.ts
new file mode 100644
index 00000000..47f56085
--- /dev/null
+++ b/src/LibreChat/packages/api/src/hermes/proxy.ts
@@ -0,0 +1,208 @@
+import http from 'node:http';
+import https from 'node:https';
+import { Readable } from 'node:stream';
+import type { Request, Response } from 'express';
+import type { Duplex } from 'node:stream';
+import type { HermesConfig, HermesUser } from './config';
+import type { WorkspaceSessions } from './sessions';
+import type { HermesDashboard } from './dashboard';
+import { HERMES_PREFIX, readWorkspaceCookie } from './sessions';
+import { getHermesRequestBody } from './body';
+import { canManageHermes } from './config';
+
+export async function sendUpstream(response: globalThis.Response, res: Response): Promise<void> {
+  res.status(response.status);
+  for (const name of [
+    'content-type',
+    'content-disposition',
+    'cache-control',
+    'x-hermes-session-id',
+    'content-range',
+    'accept-ranges',
+    'etag',
+    'last-modified',
+  ]) {
+    const value = response.headers.get(name);
+    if (value) res.setHeader(name, value);
+  }
+  res.setHeader('Cache-Control', 'no-store');
+  if (!response.body) {
+    res.end();
+    return;
+  }
+  // Node and DOM declarations describe the same runtime Web Stream with different iterator types.
+  const stream = Readable.fromWeb(
+    response.body as unknown as import('node:stream/web').ReadableStream<Uint8Array>,
+  );
+  stream.on('error', () => res.destroy());
+  res.once('close', () => stream.destroy());
+  stream.pipe(res);
+}
+
+export function isSameOrigin(origin: string | undefined, expected: string): boolean {
+  return origin === expected;
+}
+
+function dashboardPath(original: string): string {
+  const path = original.slice(HERMES_PREFIX.length) || '/';
+  // No normalization through URL(): dot segments must never escape the fixed proxy prefix.
+  const pathname = decodeURIComponent(path.split('?')[0]);
+  if (
+    !path.startsWith('/') ||
+    path.startsWith('//') ||
+    pathname.includes('\\') ||
+    pathname.split('/').some((part) => part === '..' || part === '.')
+  )
+    throw new Error('Invalid proxy path');
+  return path;
+}
+
+/** Full stock dashboard including streaming uploads; upstream credentials stay server-side. */
+export async function proxyDashboard(
+  req: Request,
+  res: Response,
+  config: HermesConfig,
+  dashboard: HermesDashboard,
+): Promise<void> {
+  const path = dashboardPath(req.originalUrl);
+  // The bridge owns authentication. A workspace page cannot replace or revoke the service login.
+  if (/^\/(?:auth|login)(?:\/|\?|$)/.test(path)) {
+    res.status(403).json({ code: 'HERMES_AUTH_MANAGED_BY_LIBRECHAT' });
+    return;
+  }
+  const headers: Record<string, string> = {
+    'X-Forwarded-Prefix': HERMES_PREFIX,
+    'X-Forwarded-Host': new URL(config.publicOrigin).host,
+    'X-Forwarded-Proto': new URL(config.publicOrigin).protocol.slice(0, -1),
+  };
+  for (const name of [
+    'content-type',
+    'accept',
+    'last-event-id',
+    'x-hermes-session-token',
+    'range',
+    'if-range',
+    'if-none-match',
+    'if-modified-since',
+  ]) {
+    const value = req.get(name);
+    if (value) headers[name] = value;
+  }
+  const init: RequestInit & { duplex?: string } = { method: req.method, headers };
+  if (!['GET', 'HEAD'].includes(req.method)) {
+    const original = getHermesRequestBody(req);
+    if (original) init.body = original as unknown as BodyInit;
+    else if (req.body !== undefined) init.body = JSON.stringify(req.body);
+    else {
+      init.body = Readable.toWeb(req) as unknown as BodyInit;
+      init.duplex = 'half';
+    }
+  }
+  const abort = new AbortController();
+  req.on('aborted', () => abort.abort());
+  res.once('close', () => abort.abort());
+  init.signal = abort.signal;
+  const response = await dashboard.fetch(path, init);
+  if (response.status >= 300 && response.status < 400) {
+    const location = response.headers.get('location') ?? '';
+    if (
+      !location.startsWith('/') ||
+      location.startsWith('//') ||
+      /^\/(?:login|auth)\b/.test(location)
+    ) {
+      res.status(502).json({ code: 'HERMES_REAUTHENTICATION_REQUIRED' });
+      return;
+    }
+    res.redirect(
+      response.status,
+      location.startsWith(`${HERMES_PREFIX}/`) ? location : `${HERMES_PREFIX}${location}`,
+    );
+    return;
+  }
+  res.setHeader('Content-Security-Policy', "frame-ancestors 'self'");
+  res.setHeader('X-Frame-Options', 'SAMEORIGIN');
+  await sendUpstream(response, res);
+}
+
+/** Only the private, authenticated dashboard origin is an upgrade target. */
+export function attachWorkspaceUpgrades(
+  server: http.Server,
+  config: HermesConfig,
+  dashboard: HermesDashboard,
+  sessions: WorkspaceSessions,
+  loadUser: (id: string) => Promise<HermesUser | undefined>,
+) {
+  const sockets = new Set<Duplex>();
+  server.on('upgrade', (req, socket, head) => {
+    if (!req.url?.startsWith(`${HERMES_PREFIX}/`)) return;
+    void (async () => {
+      const grant = sessions.get(readWorkspaceCookie(req.headers.cookie));
+      if (
+        !grant ||
+        !isSameOrigin(req.headers.origin, config.publicOrigin) ||
+        !canManageHermes(await loadUser(grant.userId), config)
+      ) {
+        socket.end('HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n');
+        return;
+      }
+      const target = new URL(config.dashboardURL);
+      const path = dashboardPath(req.url!);
+      const headers = {
+        ...req.headers,
+        host: target.host,
+        origin: target.origin,
+        cookie: await dashboard.cookie(),
+        'x-forwarded-prefix': HERMES_PREFIX,
+        'x-forwarded-proto': new URL(config.publicOrigin).protocol.slice(0, -1),
+        'x-forwarded-host': new URL(config.publicOrigin).host,
+      };
+      delete headers.authorization;
+      const request = (target.protocol === 'https:' ? https : http).request(target, {
+        method: 'GET',
+        path,
+        headers,
+      });
+      request.on('upgrade', (response, upstream, upstreamHead) => {
+        const lines = ['HTTP/1.1 101 Switching Protocols'];
+        for (const name of [
+          'upgrade',
+          'connection',
+          'sec-websocket-accept',
+          'sec-websocket-protocol',
+        ]) {
+          const value = response.headers[name];
+          if (typeof value === 'string') lines.push(`${name}: ${value}`);
+        }
+        socket.write(`${lines.join('\r\n')}\r\n\r\n`);
+        if (upstreamHead.length) socket.write(upstreamHead);
+        if (head.length) upstream.write(head);
+        sockets.add(socket);
+        let expiry: ReturnType<typeof setTimeout>;
+        const checkExpiry = () => {
+          const current = sessions.get(readWorkspaceCookie(req.headers.cookie));
+          if (!current) {
+            socket.destroy();
+            return;
+          }
+          expiry = setTimeout(checkExpiry, Math.max(1, current.expires - Date.now()));
+        };
+        checkExpiry();
+        socket.on('error', () => upstream.destroy());
+        upstream.on('error', () => socket.destroy());
+        socket.on('close', () => {
+          clearTimeout(expiry);
+          sockets.delete(socket);
+          upstream.destroy();
+        });
+        socket.pipe(upstream).pipe(socket);
+      });
+      request.on('response', () => socket.destroy());
+      request.on('error', () => socket.destroy());
+      request.setTimeout(15_000, () => request.destroy());
+      request.end();
+    })().catch(() => socket.destroy());
+  });
+  return () => {
+    for (const socket of sockets) socket.destroy();
+  };
+}
diff --git a/src/LibreChat/packages/api/src/hermes/runtime.ts b/src/LibreChat/packages/api/src/hermes/runtime.ts
new file mode 100644
index 00000000..bb8b806d
--- /dev/null
+++ b/src/LibreChat/packages/api/src/hermes/runtime.ts
@@ -0,0 +1,132 @@
+import { createHmac } from 'node:crypto';
+import type { HermesConfig, HermesSecrets } from './config';
+import type { HermesDashboard } from './dashboard';
+
+interface Profile {
+  name: string;
+  description?: string;
+}
+interface Model {
+  id: string;
+  object: 'model';
+  owned_by: string;
+  created: number;
+}
+export const profileAlias = (name: string) => `Agent: ${name}`;
+export const modelAlias = (name: string) => `Model: ${name}`;
+
+/** Hermes alone owns the agent loop. This adapter selects the profile, never executes tools. */
+export class HermesRuntime {
+  constructor(
+    private config: HermesConfig,
+    private secrets: HermesSecrets,
+    private dashboard: HermesDashboard,
+    private request: typeof fetch = fetch,
+  ) {}
+
+  async profiles(): Promise<Profile[]> {
+    const payload = await this.dashboard.json('/api/profiles');
+    if (!Array.isArray(payload.profiles)) throw new Error('HERMES_PROFILE_CONTRACT');
+    return payload.profiles.filter(
+      (p: unknown): p is Profile =>
+        typeof p === 'object' &&
+        p !== null &&
+        'name' in p &&
+        typeof p.name === 'string' &&
+        /^[a-z0-9][a-z0-9_-]{0,63}$/.test(p.name),
+    );
+  }
+
+  private key(profile: string): string {
+    return profile === 'default'
+      ? this.secrets.runtimeKey
+      : createHmac('sha256', this.secrets.bridgeKey)
+          .update(`profile:${profile}`)
+          .digest('base64url');
+  }
+
+  private path(profile: string): string {
+    return profile === 'default' ? '/v1' : `/p/${encodeURIComponent(profile)}/v1`;
+  }
+
+  private async models(profile: string): Promise<Model[]> {
+    const response = await this.request(`${this.config.runtimeURL}${this.path(profile)}/models`, {
+      headers: { Authorization: `Bearer ${this.key(profile)}` },
+      redirect: 'error',
+      signal: AbortSignal.timeout(10_000),
+    });
+    if (!response.ok) throw new Error('HERMES_PROFILE_NOT_READY');
+    const payload = (await response.json()) as { data?: Model[] };
+    if (
+      !Array.isArray(payload.data) ||
+      !payload.data.length ||
+      !payload.data.every((model) => model && typeof model.id === 'string' && model.id.length > 0)
+    )
+      throw new Error('HERMES_MODEL_CONTRACT');
+    return payload.data;
+  }
+
+  async catalog(): Promise<{ object: 'list'; data: Model[] }> {
+    const [profiles, defaults] = await Promise.all([this.profiles(), this.models('default')]);
+    const makeModel = (id: string): Model => ({
+      id,
+      object: 'model',
+      owned_by: 'hermes',
+      created: 0,
+    });
+    return {
+      object: 'list',
+      data: [
+        ...profiles.map((p) => makeModel(profileAlias(p.name))),
+        ...defaults.map((m) => makeModel(modelAlias(m.id))),
+      ],
+    };
+  }
+
+  async publish(profile: string): Promise<{ profile: string; ready: boolean }> {
+    if (!(await this.profiles()).some((p) => p.name === profile))
+      throw new Error('HERMES_UNKNOWN_PROFILE');
+    if (profile !== 'default') {
+      const response = await this.dashboard.fetch('/api/env', {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ key: 'API_SERVER_KEY', value: this.key(profile), profile }),
+      });
+      if (!response.ok) throw new Error('HERMES_PUBLISH_FAILED');
+      await response.body?.cancel();
+    }
+    try {
+      await this.models(profile);
+      return { profile, ready: true };
+    } catch {
+      return { profile, ready: false };
+    }
+  }
+
+  async resolve(alias: string): Promise<{ url: string; model: string; key: string }> {
+    let profile = 'default';
+    let requested: string | undefined;
+    if (alias.startsWith('Agent: ')) {
+      profile = alias.slice(7);
+      if (
+        !(await this.profiles()).some((p) => p.name === profile) ||
+        profileAlias(profile) !== alias
+      ) {
+        throw new Error('HERMES_UNKNOWN_PROFILE');
+      }
+    } else if (alias.startsWith('Model: ')) {
+      requested = alias.slice(7);
+      if (modelAlias(requested) !== alias) throw new Error('HERMES_UNKNOWN_MODEL');
+    } else {
+      throw new Error('HERMES_UNKNOWN_MODEL');
+    }
+    const models = await this.models(profile);
+    const model = requested ?? models[0].id;
+    if (!models.some((m) => m.id === model)) throw new Error('HERMES_UNKNOWN_MODEL');
+    return {
+      url: `${this.config.runtimeURL}${this.path(profile)}/chat/completions`,
+      model,
+      key: this.key(profile),
+    };
+  }
+}
diff --git a/src/LibreChat/packages/api/src/hermes/sessions.ts b/src/LibreChat/packages/api/src/hermes/sessions.ts
new file mode 100644
index 00000000..69ae5364
--- /dev/null
+++ b/src/LibreChat/packages/api/src/hermes/sessions.ts
@@ -0,0 +1,73 @@
+import { createHash, randomBytes, timingSafeEqual } from 'node:crypto';
+
+const TTL = 90_000;
+export const HERMES_COOKIE = 'lc_hermes_workspace';
+export const HERMES_PREFIX = '/hermes-workspace';
+interface Grant {
+  token: string;
+  userId: string;
+  expires: number;
+}
+
+/** Opaque, short-lived browser grants. Never send the LibreChat bearer or Hermes credentials. */
+export class WorkspaceSessions {
+  private grants = new Map<string, Grant>();
+  constructor(private now: () => number = Date.now) {}
+  private hash(value: string) {
+    return createHash('sha256').update(value).digest('hex');
+  }
+
+  issue(token: string, userId: string, previous?: string): string {
+    this.prune();
+    const existing = this.get(previous);
+    if (previous && existing?.userId === userId) {
+      existing.token = token;
+      existing.expires = this.now() + TTL;
+      return previous;
+    }
+    if (this.grants.size >= 1000) throw new Error('Workspace session limit');
+    if (previous) this.revoke(previous);
+    const value = randomBytes(32).toString('base64url');
+    this.grants.set(this.hash(value), { token, userId, expires: this.now() + TTL });
+    return value;
+  }
+
+  get(value: string | undefined): Grant | undefined {
+    if (!value || value.length > 128) return undefined;
+    const key = this.hash(value);
+    const grant = this.grants.get(key);
+    if (grant && grant.expires > this.now()) return grant;
+    this.grants.delete(key);
+    return undefined;
+  }
+
+  revoke(value: string) {
+    this.grants.delete(this.hash(value));
+  }
+
+  private prune() {
+    for (const [key, grant] of this.grants)
+      if (grant.expires <= this.now()) this.grants.delete(key);
+  }
+}
+
+export function readWorkspaceCookie(header: string | undefined): string | undefined {
+  const entry = header
+    ?.split(';')
+    .map((part) => part.trim())
+    .find((part) => part.startsWith(`${HERMES_COOKIE}=`));
+  return entry?.slice(HERMES_COOKIE.length + 1);
+}
+
+export function serviceKeyMatches(header: string | undefined, key: string): boolean {
+  const candidate = Buffer.from(header ?? '');
+  const expected = Buffer.from(`Bearer ${key}`);
+  return candidate.length === expected.length && timingSafeEqual(candidate, expected);
+}
+
+export function sessionKey(key: string, user: string, conversation: string): string {
+  // A stable opaque namespace; no email, user id or conversation text leaves LibreChat.
+  return createHash('sha256')
+    .update(JSON.stringify([key, user, conversation]))
+    .digest('hex');
+}
diff --git a/src/LibreChat/packages/api/src/hermes/transport.ts b/src/LibreChat/packages/api/src/hermes/transport.ts
new file mode 100644
index 00000000..cf4d7963
--- /dev/null
+++ b/src/LibreChat/packages/api/src/hermes/transport.ts
@@ -0,0 +1,50 @@
+interface TransportConfig {
+  config?: { hermes?: { enabled?: boolean; managedOnly?: boolean; endpointName?: string } };
+}
+interface TransportParams {
+  agent: object;
+  endpointOption?: { endpoint?: string | null };
+  runtime?: { appConfig?: TransportConfig } | null;
+  req?: { config?: TransportConfig } | null;
+}
+
+export class HermesExecutionRequiredError extends Error {
+  readonly code = 'HERMES_EXECUTION_REQUIRED';
+  constructor() {
+    super(
+      'Managed mode requires the Hermes chat transport. Configure agents and tools in Hermes workspace.',
+    );
+    this.name = 'HermesExecutionRequiredError';
+  }
+}
+
+/** LibreChat's unified chat transport uses AgentClient even for custom endpoints.
+ * Disable its local skill, memory and execution layer before any resource priming.
+ * Hermes profiles remain the sole owner of these capabilities.
+ */
+export function hermesTransportParams<T extends TransportParams>(params: T): T {
+  const appConfig = params.runtime?.appConfig ?? params.req?.config;
+  const config = appConfig?.config?.hermes;
+  if (!config?.enabled || !config.managedOnly) return params;
+  // Also covers API/background ingress that does not pass through the interactive chat router.
+  if (params.endpointOption?.endpoint !== config.endpointName)
+    throw new HermesExecutionRequiredError();
+  return {
+    ...params,
+    agent: {
+      ...params.agent,
+      tools: [],
+      tool_options: {},
+      tool_resources: {},
+      agent_ids: [],
+      edges: [],
+      subagents: undefined,
+    },
+    accessibleSkillIds: [],
+    manualSkills: [],
+    skillAuthoringAvailable: false,
+    memoryAvailable: false,
+    codeEnvAvailable: false,
+    fileSearchAvailable: false,
+  } as T;
+}
